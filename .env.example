# Template for .env — copy to .env and fill in.
# Every variable here overrides the matching value in config.json.

# HTTP port — overrides server.port
PORT="3000"

# API key clients must send as X-API-Key or Authorization: Bearer.
# Generate one with: openssl rand -hex 32
API_KEY="dev-api-key-12345"

# Custom RPC endpoint — overrides solana.rpcUrl.
# Required for mainnet; the public cluster URL is used while this is unset.
SOLANA_RPC_URL=""

# Base64-encoded 64-byte secret key of the payer wallet.
# While unset, loadPayer() generates a throwaway keypair per request.
# Export from a keypair file with:
#   cat ~/wallet.json | jq -r '.[0:64] | @base64d' | base64
SOLANA_SECRET_KEY=""
